# Copy this file to `.env` and fill in only what is real and verified.
# Anything left empty is simply hidden (or disabled) on the site — nothing is faked.

# Public contact email shown in the Contact section (enables copy button + mailto fallback)
VITE_CONTACT_EMAIL=

# Profile links (full URLs, e.g. https://github.com/<username>)
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Form delivery service endpoint (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# Without this, the form validates input but cannot send; it falls back to opening
# the visitor's email app if VITE_CONTACT_EMAIL is set.
VITE_CONTACT_ENDPOINT=
